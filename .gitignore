# Custom Data Directories
# Ignore raw datasets
data/raw/*
!data/raw/.gitkeep

# Ignore processed datasets, but allow documentation and plots
data/processed/*.csv
data/processed/*.xlsx
data/processed/*.parquet
data/processed/*.pkl
data/processed/*.joblib
!data/processed/.gitkeep
