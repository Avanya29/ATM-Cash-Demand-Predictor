# ===========================================================================
# ATM Cash Demand Predictor - Git Ignore Configuration
# ===========================================================================

# Environments & Local Configs
.env
.env.*
!.env.example
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Node & Frontend Dependencies / Builds
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
*.local
.eslintcache

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Jupyter Notebook & Testing Caches
.ipynb_checkpoints
.pytest_cache/
htmlcov/
.coverage
*.log

# Scratch Work & Temporary Audit Scripts
scratch/
audit_dataset.py
audit_features.py
check_dataset.py

# Raw Datasets
data/raw/*
!data/raw/.gitkeep

# Processed Datasets (heavy tables ignored; documentation & analysis plots preserved)
data/processed/*.csv
data/processed/*.xlsx
data/processed/*.parquet
data/processed/*.pkl
data/processed/*.joblib
data/processed/checkpoint_*/
!data/processed/.gitkeep

# Trained ML Model Artifacts & Checkpoints
models/*.joblib
models/**/*.joblib
models/*.pkl
models/**/*.pkl
models/checkpoint_*/
!models/model_metadata.json
!models/.gitkeep
/data/custom_datasets/*
!/data/custom_datasets/.gitkeep